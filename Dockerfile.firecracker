# OsitoK — Firecracker MicroVM Container
#
# Ultra-lightweight: boot in <200ms, ~6MB runtime footprint.
# Requires /dev/kvm access (--device /dev/kvm).
#
# Build:  docker build -f Dockerfile.firecracker -t ositok-fc .
# Run:    docker run --rm -it --device /dev/kvm ositok-fc
#
# For production Kubernetes:
#   - Use kata-containers or gVisor with Firecracker backend
#   - Or privileged pod with /dev/kvm mount

FROM debian:bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc make gnu-efi binutils curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .

# Build kernel
RUN make -C arch/x86 clean && make -C arch/x86

# Download Firecracker binary
RUN curl -fsSL https://github.com/firecracker-microvm/firecracker/releases/download/v1.7.0/firecracker-v1.7.0-x86_64.tgz \
    | tar xz -C /usr/local/bin --strip-components=1 \
    release-v1.7.0-x86_64/firecracker-v1.7.0-x86_64 && \
    mv /usr/local/bin/firecracker-v1.7.0-x86_64 /usr/local/bin/firecracker

# ── Minimal runtime ───────────────────────────────────────────
FROM debian:bookworm-slim

COPY --from=builder /usr/local/bin/firecracker /usr/local/bin/firecracker
COPY --from=builder /build/arch/x86/build/boot.efi /ositok/boot.efi
COPY --from=builder /build/arch/x86/build/kernel.elf /ositok/kernel.elf
COPY firecracker.json /ositok/config.json

# Create ESP image
RUN apt-get update && apt-get install -y --no-install-recommends dosfstools && \
    mkdir -p /ositok/esp/EFI/BOOT && \
    cp /ositok/boot.efi /ositok/esp/EFI/BOOT/BOOTX64.EFI && \
    cp /ositok/kernel.elf /ositok/esp/ && \
    dd if=/dev/zero of=/ositok/esp.img bs=1M count=64 && \
    mkfs.fat -F 32 /ositok/esp.img && \
    mkdir -p /mnt/esp && mount -o loop /ositok/esp.img /mnt/esp && \
    cp -r /ositok/esp/* /mnt/esp/ && umount /mnt/esp && \
    rm -rf /ositok/esp && \
    apt-get purge -y dosfstools && apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

ENTRYPOINT ["firecracker", "--config-file", "/ositok/config.json"]
