arch/wasm/cc-toolchain/shared_web.js
arch/wasm/cc-toolchain/worker.js
arch/wasm/cc-toolchain/web.js
arch/wasm/cc-toolchain/index.html

# Toolchain (large, download separately) — Xtensa toolchain lives
# under the xtensa arch directory after the 2026 migration.
